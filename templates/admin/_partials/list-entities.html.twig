{% set columns = columns ?? {} %}
{% set firstColumns = firstColumns ?? {
	ref: '#',
	info: {
		label: 'Info',
		badge: '{{ type }}',
	},
	date: {
		className: 'small text-muted',
		block: 'info',
		label: 'Date'|trans,
		icon: false,
		prop: 'created',
		prefix: { icon: 'created' },
		parse: 'date',
		sub: {
			prop: 'modified',
			prefix: { icon: 'modified' },
			parse: 'date',
		},
	},
} %}

{#
	Currently we only allow Automations to be disabled through the UI.
	'disable': { label: 'Disable'|trans, dropdown: true, conditions: { status: { operator: '==', compare: 'enabled' } } },
#}
{% set defaultActions = {
	'link': { label: 'Edit'|trans, dropdown: true },
	'edit': { label: 'Quick Edit'|trans },
	'hide': { label: 'Hide'|trans, dropdown: true, conditions: { visibility: { operator: '!=', compare: 'hidden' } } },
	'show': { label: 'Show'|trans, dropdown: true, conditions: { visibility: { operator: '==', compare: 'hidden' } } },
	'enable': { label: 'Enable'|trans, dropdown: true, conditions: { status: { operator: '==', compare: 'disabled' } } },
	'export': { label: 'Export'|trans, dropdown: true },
	'trash': { label: 'Trash'|trans, dropdown: true, conditions: { status: { operator: '!=', compare: 'trashed' } } },
	'restore': { label: 'Restore'|trans, dropdown: true, conditions: { status: { operator: '==', compare: 'trashed' } } },
	'delete': { label: 'Delete Permanently'|trans, dropdown: true, conditions: { status: { operator: '==', compare: 'trashed' } } },
} %}
{% set lastColumns = lastColumns ?? { actions: { label: 'Actions', view: 'grouped', actions: defaultActions } } %}

{% set columns = firstColumns|merge( columns ) %}
{% set columns = columns|merge( lastColumns ) %}

{% set header = header ?? {} %}

{% if header.actions is not defined %}
	{% set header = header|merge({ actions: [ 'search', 'filter', 'create' ] }) %}
{% endif %}

{% set filters = filters ?? [
		{
			key: 'status',
			label: 'Status'|trans,
			default: '',
			icon: 'status',
			options: [
				{ value: '',         icon: 'status',  label: 'Default'|trans },
				{ value: 'enabled',  icon: 'enable',  label: 'Enabled'|trans },
				{ value: 'disabled', icon: 'disable', label: 'Disabled'|trans },
				{ value: 'trashed',  icon: 'delete',  label: 'Trashed'|trans },
			]
		}
] %}

{% set footer = footer ?? {
	actions: [
		'total',
		'pagination'
	]
} %}

{# @todo Create custom Twig filter #}
{% if not is_granted( 'ROLE_EDITOR' ) %}
	{% set actionGroups = {
		columns: columns.actions.actions ?? {},
		header: header.actions ?? {},
		footer: footer.actions ?? {},
	} %}

	{% set protectedActions = [ 'create', 'edit', 'export', 'delete', 'link' ] %}

	{% for prop, group in actionGroups %}
		{% set groupActions = group|filter((value, key) =>
			key not in protectedActions
			and (
				value is iterable
					? (value.action ?? null) not in protectedActions
					: value not in protectedActions
			)
		) %}

		{% if 'columns' === prop %}
			{% set actionsColumn = columns.actions|merge({ actions: groupActions }) %}
			{% if actionsColumn.actions %}
				{% set columns = columns|merge({ actions: actionsColumn }) %}
			{% else %}
				{% set columns = columns|filter( ( column, key ) => key !== 'actions' ) %}
			{% endif %}
		{% elseif header is defined and 'header' === prop %}
			{% set header = header|merge({ actions: groupActions }) %}
		{% elseif footer is defined and 'footer' === prop %}
			{% set footer = footer|merge({ actions: groupActions }) %}
		{% endif %}
	{% endfor %}
{% endif %}

{% set query = query ?? { limit: 10, total: true, relations: true } %}

{{ include('admin/_partials/react/ListController.html.twig') }}
