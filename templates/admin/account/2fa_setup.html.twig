{% extends 'admin/index.html.twig' %}

{% block content %}
	{{ parent() }}

	<div class="card my-3">
		<div class="card-body">
			<div class="text-center mb-4">
				<i class="bi bi-shield-lock lead text-primary"></i>
				<h5 class="mt-2">{{ 'Enable two-factor authentication'|trans }}</h5>
				<p class="text-muted">{{ 'Choose how you want to receive verification codes'|trans }}</p>
			</div>

			<div class="row g-4">
				<div class="col-md-6">
					<div class="card h-100">
						<div class="card-header fw-bold">{{ 'Authenticator App (Recommended)'|trans }}</div>
						<div class="card-body text-center">
							<p class="text-muted mb-3">{{ 'Scan the QR code with Google Authenticator, Authy, or any TOTP app'|trans }}</p>

							{% if qr_code %}
								<img src="{{ qr_code }}" alt="QR Code" class="img-fluid border rounded mb-3" style="max-width: 200px;" />
							{% endif %}

							<p class="mb-1 small">{{ 'Or enter this secret manually:'|trans }}</p>
							<code class="fs-6 user-select-all">{{ secret }}</code>

							<hr>

							<form method="post" action="{{ path('syncengine_account_2fa_totp_verify') }}" class="row g-2 justify-content-center">
								<input type="hidden" name="secret" value="{{ secret }}" />
								<input type="hidden" name="_csrf_token" value="{{ csrf_token('verify_2fa') }}" />

								<div class="col-8">
									<input
										type="text"
										name="_auth_code"
										class="form-control text-center fs-5"
										placeholder="000000"
										required
										pattern="[0-9]{6}"
										inputmode="numeric"
										autocomplete="one-time-code"
									/>
								</div>
								<div class="col-4">
									<button type="submit" class="btn btn-primary w-100">{{ 'Verify'|trans }}</button>
								</div>
							</form>
						</div>
					</div>
				</div>

				<div class="col-md-6">
					<div class="card h-100">
						<div class="card-header fw-bold">{{ 'Email Verification'|trans }}</div>
						<div class="card-body text-center d-flex flex-column justify-content-center">
							<p class="text-muted mb-3">{{ 'We will send a 6-digit code to your email address'|trans }}</p>

							<a href="{{ path('syncengine_account_2fa_email_setup') }}" class="btn btn-outline-primary btn-lg">
								<i class="bi bi-envelope-paper"></i> {{ 'Send Code to Email'|trans }}
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
