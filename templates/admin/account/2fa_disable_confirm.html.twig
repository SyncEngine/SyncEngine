{% extends 'admin/index.html.twig' %}

{% block content %}
	{{ parent() }}

	<div class="card my-3 border-danger">
		<div class="card-body">
			<div class="text-center mb-4">
				<i class="bi bi-shield-x lead text-danger"></i>
				<h5 class="mt-2">{{ 'Are you sure you want to disable two-factor authentication?'|trans }}</h5>
				<p class="text-muted">{{ 'You will need to re-enable 2FA after verifying your password'|trans }}</p>
			</div>

			<form method="post" action="{{ path('syncengine_account_2fa_disable') }}" class="row g-3 justify-content-center">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('disable_2fa') }}" />
				<div class="col-md-6">
					<label for="password" class="form-label">{{ 'Enter your password to confirm'|trans }}</label>
					<input
						type="password"
						id="password"
						name="password"
						class="form-control"
						required
						autofocus
					/>
				</div>

				<div class="col-md-6 d-flex align-items-end gap-2">
					<a href="{{ path('syncengine_account_index') }}" class="btn btn-outline-secondary w-50">
						{{ 'Cancel'|trans }}
					</a>
					<button type="submit" class="btn btn-danger w-50">
						<i class="bi bi-shield-x"></i> {{ 'Disable 2FA'|trans }}
					</button>
				</div>
			</form>
		</div>
	</div>
{% endblock %}
