{% set header = header ?? {
	icon: 'automation',
	title: 'Automations'|trans,
} %}

{% set columns = columns ?? {
	info: {
		label: 'Info'|trans,
		badge: {
			options: [
				{
					compare: true,
					value: '{{ data.running.active }}',
					label: 'Running',
					type: 'info',
					icon: 'play-circle',
				}
			]
		},
	},
	link: {
		label: 'URL'|trans,
		href: url( 'syncengine_execute_endpoint', { endpoint: '{endpoint}' } ),
		text: path( 'syncengine_api_endpoint_action', { endpoint: '{endpoint}' } ),
	},
	connections: {
		block: 'entities',
		label: 'Uses'|trans,
		prop: '_dependencies',
	},
} %}

{% set lastColumns = {
	actions: {
		label: 'Actions'|trans,
		view: 'grouped',
		actions: {
			'reset': {
				conditions: {
					"data.running.active": true,
				},
				action: 'request',
				confirm: 'You are about to reset this process, are you sure?'|trans,
				request: 'reset',
				label: 'Reset'|trans,
				title: 'Reset automation'|trans ~ ': {{ automation.name }}',
				icon: 'event-stop',
				variant: 'warning',
				params: {
					id: 'entityId',
					action: 'reset',
				},
			},
			'link': { label: 'Edit'|trans, dropdown: true },
			'edit': { label: 'Quick Edit'|trans },
			'disable': { label: 'Disable'|trans, dropdown: true, conditions: { status: { operator: '==', compare: 'enabled' } } },
			'enable': { label: 'Enable'|trans, dropdown: true, conditions: { status: { operator: '==', compare: 'disabled' } } },
			'export': { label: 'Export'|trans, dropdown: true },
			'trash': { label: 'Trash'|trans, dropdown: true, conditions: { status: { operator: '!=', compare: 'trashed' } } },
			'restore': { label: 'Restore'|trans, dropdown: true, conditions: { status: { operator: '==', compare: 'trashed' } } },
			'delete': { label: 'Delete Permanently'|trans, dropdown: true, conditions: { status: { operator: '==', compare: 'trashed' } } },
		}
	}
} %}

{% include 'admin/_partials/list-entities.html.twig' with {
	id: 'automation_list',
	type: 'automation',
	entity: true,
} %}
