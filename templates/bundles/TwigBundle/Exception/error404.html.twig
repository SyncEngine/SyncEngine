{# templates/bundles/TwigBundle/Exception/error500.html.twig #}
{% extends 'index.html.twig' %}

{% set header = 'Page not found'|trans %}

{% block content %}
	{{ parent() }}

	<p>
		{{ 'The requested page couldn\'t be located.'|trans }}<br>
		{{ 'Checkout for any URL misspelling or return to the homepage'|trans }}
	</p>
	<p>
		<a class="btn btn-primary" href="{{ path('index') }}">{{ 'Return'|trans }}</a>
	</p>
{% endblock %}
