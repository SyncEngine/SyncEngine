{# % extends '@SchebTwoFactor/Authentication/form.html.twig' %} #}

{# Authentication errors #}
{% if authenticationError %}
	<div class="alert alert-warning">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>
{% endif %}

{% set providerLabels = {
	'totp': 'Authenticator App'|trans,
	'email': 'Email'|trans
} %}
{% set providerInstructions = {
	'totp': 'Fill in the code from your authenticator app'|trans,
	'email': 'Fill in the code send to your email'|trans
} %}

{# Let the user select the authentication method #}
{% if availableTwoFactorProviders|length > 1 %}
	<p class="text-muted text-center">
		{{ "choose_provider"|trans({}, 'SchebTwoFactorBundle') }}:
		{% for provider in availableTwoFactorProviders %}
			<a href="{{ path("2fa_login", {"preferProvider": provider}) }}">{{ providerLabels[provider] }}</a>
		{% endfor %}
	</p>
{% endif %}

{# Display current two-factor provider #}
<p class="label mt-4">
	<label for="_auth_code" class="h6">{{ providerInstructions[twoFactorProvider] }}</label>
</p>

<form action="{{ checkPathUrl ? checkPathUrl: path(checkPathRoute) }}" method="post" class="{{ classes|default('') }}">
	{% if isCsrfProtectionEnabled %}
		<input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
	{% endif %}
    <input type="hidden" name="_target_path" value="{{ path('syncengine_admin_index') }}">

	<div class="form-floating mb-3">
		<input
			class="form-control"
			id="_auth_code"
			type="text"
			name="{{ authCodeParameterName }}"
			autocomplete="one-time-code"
			autofocus
			placeholder="000000"
		>
		<label for="_auth_code">{{ "auth_code"|trans({}, 'SchebTwoFactorBundle') }}</label>
	</div>


	{% if displayTrustedOption %}
		<div class="form-floating mb-3 form-check">
			<input id="_trusted" type="checkbox" class="form-check-input" name="{{ trustedParameterName }}" />
			<label for="_trusted">{{ "trusted"|trans({}, 'SchebTwoFactorBundle') }}</label>
		</div>
	{% endif %}

	<p class="submit justify-content-between d-flex">
		<input type="submit" class="btn btn-primary" value="{{ "Verify"|trans }}" />

		{# The logout link gives the user a way out if they can't complete two-factor authentication #}
		<a class="btn btn-secondary" href="{{ logoutPath }}">{{ 'Cancel'|trans }}</a>
	</p>

</form>
